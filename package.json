{
  "name": "urieugenio-webshop-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Static site generator for the Uri Eugenio webshop",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "node build.mjs",
    "clean": "node build.mjs --clean",
    "serve": "node build.mjs --serve",
    "serve:lan": "node build.mjs --serve --lan",
    "backoffice": "node backoffice.mjs",
    "booklet": "node booklet.mjs",
    "scarf-sticker": "node scarf-sticker.mjs",
    "story-booklet": "node story-booklet.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "marked": "^18.0.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.4",
    "sortablejs": "^1.15.6"
  }
}
