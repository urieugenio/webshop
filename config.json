{
  "sourcesDir": "../content/sources",
  "outDir": "../build/dist",
  "cacheDir": "../build/cache",

  "site": {
    "title": "Uri Eugenio — exclusive handmade crochet",
    "description": "Exclusive handmade crochet by Uri Eugenio. One of a kind pieces, hand-dyed merino wool.",
    "lang": "en",
    "tagline": "exclusive handmade crochet",
    "taglineBy": "by",
    "contact": {
      "name": "Uri Eugenio",
      "email": "uri@uri.eu",
      "instagram": "urieugenio",
      "website": "https://uri.eu",
      "websiteText": "dance videos and many more pictures"
    },
    "url": "https://uri.fashion",
    "business": {
      "name": "Uri Eugenio Handmade Crochet",
      "kvk": "34336736",
      "address": ["Hudsonstraat 53-3", "1057 RX Amsterdam", "Netherlands"],
      "vatScheme": "kor",
      "shipWithin": "3 working days"
    }
  },

  "content": {
    "folder": "content",
    "file": "site.md",
    "images": "images",
    "imageWidths": [480, 820, 1240, 1640],
    "landscapeMinAspect": 1.1,
    "cropAspect": 1.5,
    "cropPosition": "north",
    "imageQuality": 82
  },

  "logo": {
    "file": "logo.svg",
    "removeClasses": [],
    "trimToContent": false,
    "landscapeWidthAt16x9": 0.62,
    "portraitWidthAt9x16": 0.85,
    "taglineTop": 0.10,
    "taglineWidthOfLogo": 0.55
  },

  "theme": {
    "bg": "#131313",
    "surface": "#252526",
    "line": "#3c3c3c",
    "text": "#efefef",
    "muted": "#8f8f8f",
    "accent": "#ffc902",
    "accentText": "#131313",
    "embossLight": "rgba(255,255,255,0.10)",
    "embossDark": "rgba(0,0,0,0.60)",
    "imageShadow": "none",
    "thumbBorder": "#222"
  },

  "layout": {
    "sideMargin": 40,
    "sideMarginPhone": 4,
    "phoneBreakpoint": 600,
    "phoneColumns": 3,
    "minThumbWidth": 210,
    "gap": 10,
    "border": 1,
    "galleryRowScale": 1.15,
    "contentWidth": 920
  },

  "thumbs": {
    "collection": { "tileSizes": [256, 512], "tilesPerRow": 4, "fit": "cover" },
    "gallery":    { "tileSizes": [320, 640], "tilesPerRow": 4, "fit": "fill" },
    "pad": 2,
    "quality": 82,
    "sharpen": true,
    "lazyMargin": 800
  },

  "detail": {
    "widths": [720, 1080, 1600, 2400],
    "quality": 85
  },

  "splash": {
    "folder": "splash",
    "aspects": ["32:9", "24:9", "16:9", "4:3", "3:4", "9:16"],
    "frame": [7680, 2160],
    "frameScales": [1, 0.6667, 0.5, 0.25],
    "quality": 80,
    "slideSeconds": 7,
    "fadeSeconds": 1.6
  },

  "animation": {
    "paneSeconds": 1.0,
    "ease": "cubic-bezier(0.215, 0.61, 0.355, 1)",
    "menuSeconds": 0.5
  },

  "colors": {
    "multiLabel": "multicolour",
    "palette": [
      { "name": "black",  "hex": "#1c1c1c" },
      { "name": "grey",   "hex": "#8c8c8c", "refs": ["#8c8c8c", "#5a5a5a", "#b8b4b0"] },
      { "name": "white",  "hex": "#f2f0ea", "refs": ["#f2f0ea", "#e0dcd2"] },
      { "name": "beige",  "hex": "#d6c1a3", "refs": ["#d6c1a3", "#c4ab8c", "#e6d6bf"] },
      { "name": "brown",  "hex": "#7a5236", "refs": ["#7a5236", "#a0806a", "#5c3d2a"] },
      { "name": "red",    "hex": "#c8202c", "refs": ["#c8202c", "#8e1a22"] },
      { "name": "orange", "hex": "#f07a2a", "refs": ["#f07a2a", "#ff5a3c", "#f4a070", "#e07060"] },
      { "name": "yellow", "hex": "#f2cf2a", "refs": ["#f2cf2a", "#d8b030"] },
      { "name": "green",  "hex": "#2f9e44", "refs": ["#2f9e44", "#7fdc2a", "#1d6b3a", "#c8f040"] },
      { "name": "blue",   "hex": "#1e78d0", "refs": ["#1e78d0", "#1b3a7a", "#7fd6f0", "#108ab0"] },
      { "name": "purple", "hex": "#7d3c98", "refs": ["#7d3c98", "#a07ab8", "#c4b4e4", "#9080d0"] },
      { "name": "pink",   "hex": "#ec5fa8", "refs": ["#ec5fa8", "#f4b6c8", "#c0306a"] }
    ],
    "analysis": {
      "region": [0.30, 0.08, 0.80, 0.22],
      "multiRegions": [[0.30, 0.08, 0.80, 0.22], [0.47, 0.22, 0.80, 0.58]],
      "multiDelta": 18.3,
      "multiShare": 0.1,
      "noMainColours": 4
    }
  },

  "collections": {
    "beanies": {
      "filters": ["price", "size", "model", "thickness"]
    },
    "scarves": {
      "filters": ["price", "model", "length", "width"],
      "colorAnalysis": {
        "region": [0.15, 0.30, 0.85, 0.55],
        "multiRegions": [[0.12, 0.18, 0.88, 0.55], [0.15, 0.55, 0.70, 0.80]]
      }
    }
  },

  "shop": {
    "currency": "EUR",
    "locale": "nl-NL",
    "liveInventory": true,
    "apiBase": "",
    "pollSeconds": 60,
    "reserveMinutes": 30,
    "stripeTax": false,
    "previewSoldIds": []
  }
}
